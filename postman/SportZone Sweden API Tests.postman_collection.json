    {
      "name": "02 - Matches - GET",
      "item": [
        {
          "name": "TC02 - Get All Matches",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Get All Matches returns HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const matches = pm.response.json();",
                  "",
                  "    pm.test(\"Response contains an array of matches\", function () {",
                  "        pm.expect(matches).to.be.an(\"array\");",
                  "    });",
                  "",
                  "    pm.test(\"Each match has an ID\", function () {",
                  "        matches.forEach(function (match) {",
                  "            pm.expect(match.id).to.exist;",
                  "        });",
                  "    });",
                  "",
                  "    if (matches.length > 0) {",
                  "        // Select an ID that actually exists in the response.",
                  "        const selectedMatch = matches[0];",
                  "",
                  "        pm.environment.set(",
                  "            \"matchId\",",
                  "            String(selectedMatch.id)",
                  "        );",
                  "",
                  "        console.log(\"Saved matchId:\", selectedMatch.id);",
                  "    } else {",
                  "        throw new Error(\"No matches returned by the API.\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.unset(\"matchId\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/matches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches"
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC03 - Get Match By ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Get Match By ID returns HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const match = pm.response.json();",
                  "    const requestedMatchId = pm.environment.get(\"matchId\") || pm.collectionVariables.get(\"matchId\");",
                  "",
                  "    pm.test(\"Returned ID matches the requested ID\", function () {",
                  "        pm.expect(Number(match.id)).to.eql(Number(requestedMatchId));",
                  "    });",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const requestedMatchId = pm.environment.get(\"matchId\") || pm.collectionVariables.get(\"matchId\");",
                  "",
                  "if (!requestedMatchId) {",
                  "    throw new Error(\"matchId is missing. Run TC02 first.\");",
                  "}",
                  "",
                  "console.log(\"Requested match ID:\", requestedMatchId);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/matches/{{matchId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches",
                "{{matchId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC04 - Match Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Nonexistent match returns HTTP 404\", () => {\r",
                  "    pm.response.to.have.status(404);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Error response contains a message\", () => {\r",
                  "    const response = pm.response.json();\r",
                  "\r",
                  "    pm.expect(response.error).to.be.a(\"string\").and.not.empty;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const baseUrl = pm.environment.get(\"baseUrl\");\r",
                  "\r",
                  "pm.sendRequest(\r",
                  "    {\r",
                  "        url: `${baseUrl}/api/matches`,\r",
                  "        method: \"GET\"\r",
                  "    },\r",
                  "    (error, response) => {\r",
                  "        if (error || response.code !== 200) {\r",
                  "            throw new Error(\r",
                  "                \"Unable to retrieve matches for the negative test.\"\r",
                  "            );\r",
                  "        }\r",
                  "\r",
                  "        const matches = response.json();\r",
                  "        const ids = matches.map(match => Number(match.id));\r",
                  "\r",
                  "        const candidate = ids.length\r",
                  "            ? Math.max(...ids) + 1\r",
                  "            : 1;\r",
                  "\r",
                  "        pm.collectionVariables.set(\r",
                  "            \"nonexistentMatchId\",\r",
                  "            String(candidate)\r",
                  "        );\r",
                  "    }\r",
                  ");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/matches/999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches",
                "999"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Matches - POST",
      "item": [
        {
          "name": "TC05 — Create Match",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uniqueId = pm.variables.replaceIn(\"{{$guid}}\");\r",
                  "\r",
                  "pm.collectionVariables.set(\"newHomeTeam\", \"Home Team \" + uniqueId);\r",
                  "pm.collectionVariables.set(\"newAwayTeam\", \"Away Team \" + uniqueId);\r",
                  "\r",
                  "const futureDate = new Date();\r",
                  "futureDate.setDate(futureDate.getDate() + 7);\r",
                  "\r",
                  "pm.collectionVariables.set(\r",
                  "    \"newMatchDate\",\r",
                  "    futureDate.toISOString().split(\"T\")[0]\r",
                  ");\r",
                  "\r",
                  "pm.collectionVariables.unset(\"createdMatchId\");\r",
                  "pm.collectionVariables.unset(\"deletedMatchId\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "",
                  "    pm.test(\"Response contains a generated match ID\", function () {",
                  "        pm.expect(response.id).to.exist;",
                  "        pm.expect(response.id).to.be.a(\"number\");",
                  "    });",
                  "",
                  "    // Save the ID in the active environment",
                  "    pm.environment.set(\"createdMatchId\", response.id);",
                  "",
                  "    console.log(\"Created match ID:\", response.id);",
                  "} else {",
                  "    console.log(\"POST request failed:\", pm.response.text());",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"homeTeam\": \"{{newHomeTeam}}\",\r\n  \"awayTeam\": \"{{newAwayTeam}}\",\r\n  \"homeScore\": null,\r\n  \"awayScore\": null,\r\n  \"date\": \"{{newMatchDate}}\",\r\n  \"status\": \"scheduled\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/matches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - Matches - PUT",
      "item": [
        {
          "name": "TC06 — Update Created Match",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Read the ID from the active environment: SportZone Local\r",
                  "const matchId = pm.environment.get(\"createdMatchId\");\r",
                  "\r",
                  "if (!matchId) {\r",
                  "    throw new Error(\r",
                  "        \"createdMatchId is missing from the active environment. Run TC05 first.\"\r",
                  "    );\r",
                  "}\r",
                  "\r",
                  "console.log(\"Updating match ID:\", matchId);\r",
                  "\r",
                  "// Generate unique team names\r",
                  "const runId = pm.variables.replaceIn(\"{{$guid}}\")\r",
                  "    .replace(/-/g, \"\")\r",
                  "    .slice(0, 8);\r",
                  "\r",
                  "const homeTeam = `UpdatedHome_${runId}`;\r",
                  "const awayTeam = `UpdatedAway_${runId}`;\r",
                  "\r",
                  "pm.collectionVariables.set(\"updatedHomeTeam\", homeTeam);\r",
                  "pm.collectionVariables.set(\"updatedAwayTeam\", awayTeam);\r",
                  "\r",
                  "// Reuse the date generated by TC05\r",
                  "const date = pm.collectionVariables.get(\"newMatchDate\");\r",
                  "\r",
                  "if (!date) {\r",
                  "    throw new Error(\r",
                  "        \"newMatchDate is missing. Check the TC05 Pre-request script.\"\r",
                  "    );\r",
                  "}\r",
                  "\r",
                  "pm.collectionVariables.set(\"updatedMatchDate\", date);\r",
                  "\r",
                  "// Generate scores\r",
                  "const homeScore = Math.floor(Math.random() * 6);\r",
                  "const awayScore = Math.floor(Math.random() * 6);\r",
                  "\r",
                  "pm.collectionVariables.set(\"updatedHomeScore\", String(homeScore));\r",
                  "pm.collectionVariables.set(\"updatedAwayScore\", String(awayScore));\r",
                  "\r",
                  "console.log(\"Updated home team:\", homeTeam);\r",
                  "console.log(\"Updated away team:\", awayTeam);\r",
                  "console.log(\"Updated scores:\", homeScore, \"-\", awayScore);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Update Match returns HTTP 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "if (pm.response.code === 200) {\r",
                  "    const match = pm.response.json();\r",
                  "\r",
                  "    // Read IDs and test data from their correct variable scopes.\r",
                  "    const createdMatchId = pm.environment.get(\"createdMatchId\");\r",
                  "    const updatedHomeTeam = pm.collectionVariables.get(\"updatedHomeTeam\");\r",
                  "    const updatedAwayTeam = pm.collectionVariables.get(\"updatedAwayTeam\");\r",
                  "    const updatedHomeScore = pm.collectionVariables.get(\"updatedHomeScore\");\r",
                  "    const updatedAwayScore = pm.collectionVariables.get(\"updatedAwayScore\");\r",
                  "\r",
                  "    pm.test(\"Updated ID remains unchanged\", function () {\r",
                  "        pm.expect(createdMatchId).to.exist;\r",
                  "        pm.expect(Number(match.id)).to.eql(Number(createdMatchId));\r",
                  "    });\r",
                  "\r",
                  "    pm.test(\"Updated team names match the submitted data\", function () {\r",
                  "        pm.expect(match.homeTeam).to.eql(updatedHomeTeam);\r",
                  "        pm.expect(match.awayTeam).to.eql(updatedAwayTeam);\r",
                  "    });\r",
                  "\r",
                  "    pm.test(\"Updated scores match the submitted scores\", function () {\r",
                  "        pm.expect(Number(match.homeScore)).to.eql(Number(updatedHomeScore));\r",
                  "        pm.expect(Number(match.awayScore)).to.eql(Number(updatedAwayScore));\r",
                  "    });\r",
                  "\r",
                  "    pm.test(\"Updated match is finished\", function () {\r",
                  "        pm.expect(match.status).to.eql(\"finished\");\r",
                  "    });\r",
                  "} else {\r",
                  "    console.log(\"Update request failed:\", pm.response.text());\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"homeTeam\": \"{{updatedHomeTeam}}\",\r\n  \"awayTeam\": \"{{updatedAwayTeam}}\",\r\n  \"homeScore\": {{updatedHomeScore}},\r\n  \"awayScore\": {{updatedAwayScore}},\r\n  \"date\": \"{{updatedMatchDate}}\",\r\n  \"status\": \"finished\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/matches/{{createdMatchId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches",
                "{{createdMatchId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "05 - Matches - DELETE",
      "item": [
        {
          "name": "TC07 — Delete Created Match",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const matchId = pm.environment.get(\"createdMatchId\");\r",
                  "\r",
                  "if (!matchId) {\r",
                  "    throw new Error(\r",
                  "        \"createdMatchId is missing from the SportZone Local environment. Run TC05 first.\"\r",
                  "    );\r",
                  "}\r",
                  "\r",
                  "console.log(\"Deleting match ID:\", matchId);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Delete Match returns HTTP 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "if (pm.response.code === 200) {\r",
                  "    const response = pm.response.json();\r",
                  "    const createdMatchId = pm.environment.get(\"createdMatchId\");\r",
                  "\r",
                  "    pm.test(\"Deleted response identifies the correct match\", function () {\r",
                  "        pm.expect(Number(response.id)).to.eql(Number(createdMatchId));\r",
                  "    });\r",
                  "\r",
                  "    pm.test(\"Deletion response contains a message\", function () {\r",
                  "        pm.expect(response.message).to.be.a(\"string\").and.not.empty;\r",
                  "    });\r",
                  "\r",
                  "    // Save the deleted ID in the SportZone Local environment.\r",
                  "    pm.environment.set(\"deletedMatchId\", createdMatchId);\r",
                  "\r",
                  "    console.log(\"Deleted match ID saved:\", createdMatchId);\r",
                  "} else {\r",
                  "    console.error(\"Delete failed:\", pm.response.text());\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/matches/{{createdMatchId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches",
                "{{createdMatchId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "TC08 — Verify Deleted Match",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const deletedMatchId = pm.environment.get(\"deletedMatchId\");\r",
                  "\r",
                  "if (!deletedMatchId) {\r",
                  "    throw new Error(\r",
                  "        \"deletedMatchId is missing from the SportZone Local environment. Run TC07 first.\"\r",
                  "    );\r",
                  "}\r",
                  "\r",
                  "console.log(\"Verifying deleted match ID:\", deletedMatchId);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Deleted match returns HTTP 404\", function () {\r",
                  "    pm.response.to.have.status(404);\r",
                  "});\r",
                  "\r",
                  "if (pm.response.code === 404) {\r",
                  "    const response = pm.response.json();\r",
                  "\r",
                  "    pm.test(\"Error message confirms match was not found\", function () {\r",
                  "        pm.expect(response.error).to.eql(\"Match not found\");\r",
                  "    });\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/matches/{{deletedMatchId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "matches",
                "{{deletedMatchId}}"
              ]
            }
          },
          "response": []
        }
      ]
