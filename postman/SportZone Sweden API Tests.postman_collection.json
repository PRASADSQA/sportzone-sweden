    {
      "name": "06 - Teams",
      "item": [
        {
          "name": "TC09 — Get Teams",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Get Teams returns HTTP 200\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const teams = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Teams response is an array\", () => {\r",
                  "    pm.expect(teams).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Each team has a valid ID and name\", () => {\r",
                  "    teams.forEach(team => {\r",
                  "        pm.expect(team.id).to.be.a(\"number\");\r",
                  "        pm.expect(Number.isInteger(team.id)).to.eql(true);\r",
                  "\r",
                  "        pm.expect(team.name).to.be.a(\"string\").and.not.empty;\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Team IDs are unique\", () => {\r",
                  "    const ids = teams.map(team => team.id);\r",
                  "\r",
                  "    pm.expect(new Set(ids).size).to.eql(ids.length);\r",
                  "});"
                ],
                "type": "text/javascript",
