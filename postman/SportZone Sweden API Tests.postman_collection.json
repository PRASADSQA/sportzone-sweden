    {
      "name": "TC05 — Get Teams",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const teams = pm.response.json();\r",
              "\r",
              "pm.test(\"Teams response is an array\", function () {\r",
              "    pm.expect(teams).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Four sample teams are returned\", function () {\r",
              "    pm.expect(teams).to.have.lengthOf(4);\r",
              "});\r",
              "\r",
              "pm.test(\"Every team has a numeric ID and a name\", function () {\r",
              "    teams.forEach(function (team) {\r",
              "        pm.expect(team.id).to.be.a(\"number\");\r",
              "        pm.expect(team.name).to.be.a(\"string\");\r",
              "        pm.expect(team.name.trim().length).to.be.above(0);\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Team IDs are unique\", function () {\r",
              "    const ids = teams.map(team => team.id);\r",
              "\r",
              "    pm.expect(new Set(ids).size).to.eql(ids.length);\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/teams",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "api",
            "teams"
          ]
        }
      },
      "response": []
    },
    {
      "name": "TC06 — Get League Standings",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const standings = pm.response.json();\r",
              "\r",
              "pm.test(\"Standings response is an array\", function () {\r",
              "    pm.expect(standings).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Four teams are listed\", function () {\r",
              "    pm.expect(standings).to.have.lengthOf(4);\r",
              "});\r",
              "\r",
              "pm.test(\"Standings contain valid values\", function () {\r",
              "    standings.forEach(function (team) {\r",
              "        pm.expect(team.position).to.be.a(\"number\");\r",
              "        pm.expect(team.team).to.be.a(\"string\");\r",
              "        pm.expect(team.played).to.be.a(\"number\");\r",
              "        pm.expect(team.points).to.be.a(\"number\");\r",
              "\r",
              "        pm.expect(team.position).to.be.above(0);\r",
              "        pm.expect(team.played).to.be.at.least(0);\r",
              "        pm.expect(team.points).to.be.at.least(0);\r",
              "    });\r",
              "});\r",
              "\r",
              "pm.test(\"Positions are in ascending order\", function () {\r",
              "    for (let i = 1; i < standings.length; i++) {\r",
              "        pm.expect(standings[i].position)\r",
              "            .to.be.above(standings[i - 1].position);\r",
              "    }\r",
              "});\r",
              "\r",
              "pm.test(\"First team is Stockholm FC\", function () {\r",
              "    pm.expect(standings[0].team).to.eql(\"Stockholm FC\");\r",
              "    pm.expect(standings[0].position).to.eql(1);\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/standings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "standings"
          ]
        }
      },
      "response": []
    }
  ]
