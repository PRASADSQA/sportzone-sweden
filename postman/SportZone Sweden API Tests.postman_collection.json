    {
      "name": "07 - Standings",
      "item": [
        {
          "name": "TC10 — Get League Standings",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Get Standings returns HTTP 200\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const standings = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Standings response is an array\", () => {\r",
                  "    pm.expect(standings).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Each row contains valid fields\", () => {\r",
                  "    standings.forEach(row => {\r",
                  "        pm.expect(row.position).to.be.a(\"number\");\r",
                  "        pm.expect(row.played).to.be.a(\"number\");\r",
                  "        pm.expect(row.points).to.be.a(\"number\");\r",
                  "\r",
                  "        pm.expect(row.position).to.be.above(0);\r",
                  "        pm.expect(row.played).to.be.at.least(0);\r",
                  "        pm.expect(row.points).to.be.at.least(0);\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Standings positions are ordered\", () => {\r",
                  "    for (let i = 1; i < standings.length; i++) {\r",
                  "        pm.expect(standings[i].position).to.be.at.least(\r",
                  "            standings[i - 1].position\r",
                  "        );\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set(\r",
                  "    \"standingsRequestStartedAt\",\r",
                  "    new Date().toISOString()\r",
                  ");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/standings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
