    {
      "name": "TC01 - API Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response is valid JSON\", function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "const body = pm.response.json();\r",
              "\r",
              "pm.test(\"Health status is OK\", function () {\r",
              "    pm.expect(body.status).to.eql(\"ok\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains status field\", function () {\r",
              "    pm.expect(body).to.have.property(\"status\");\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "TC02 - Get All Matches",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "pm.test(\"Get All Matches returns 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const matches = pm.response.json();\r",
              "\r",
              "pm.test(\"Matches response is a non-empty array\", () => {\r",
              "    pm.expect(matches).to.be.an(\"array\").that.is.not.empty;\r",
              "});\r",
              "\r",
              "// Get the ID from the first match returned by the API.\r",
              "const matchId = matches[0].id;\r",
              "\r",
              "// Save it for subsequent requests.\r",
              "pm.environment.set(\"matchId\", String(matchId));\r",
              "\r",
              "console.log(\"Saved matchId:\", matchId);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/matches",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "matches"
          ]
        }
      },
      "response": []
    },
    {
      "name": "TC03 - Get Match By ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const match = pm.response.json();\r",
              "\r",
              "pm.test(\"Correct match ID is returned\", function () {\r",
              "    pm.expect(match.id).to.eql(101);\r",
              "});\r",
              "\r",
              "pm.test(\"Home team is Stockholm FC\", function () {\r",
              "    pm.expect(match.homeTeam).to.eql(\"Stockholm FC\");\r",
              "});\r",
              "\r",
              "pm.test(\"Away team is Malmo United\", function () {\r",
              "    pm.expect(match.awayTeam).to.eql(\"Malmo United\");\r",
              "});\r",
              "\r",
              "pm.test(\"Home score is 2\", function () {\r",
              "    pm.expect(match.homeScore).to.eql(2);\r",
              "});\r",
              "\r",
              "pm.test(\"Away score is 1\", function () {\r",
              "    pm.expect(match.awayScore).to.eql(1);\r",
              "});\r",
              "\r",
              "pm.test(\"Finished match has valid scores\", function () {\r",
              "    pm.expect(match.status).to.eql(\"finished\");\r",
              "    pm.expect(match.homeScore).to.be.a(\"number\");\r",
              "    pm.expect(match.awayScore).to.be.a(\"number\");\r",
              "    pm.expect(match.homeScore).to.be.at.least(0);\r",
              "    pm.expect(match.awayScore).to.be.at.least(0);\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/matches/{{matchId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "matches",
            "{{matchId}}"
          ]
        }
      },
      "response": []
    },
